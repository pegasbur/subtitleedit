SUBTITLE_EDIT_IMAGE=ghcr.io/pegasbur/subtitleedit:latest
SUBTITLE_EDIT_CONTAINER_NAME=subtitleedit
SUBTITLE_EDIT_HTTP_PORT=5800
SUBTITLE_EDIT_CONFIG_PATH=/mnt/user/appdata/subtitleedit
SUBTITLE_EDIT_DATA_PATH=/mnt/user/data

# Unraid identity, matching the host paths above.
# Generic Linux: set USER_ID=1000 and GROUP_ID=1000 and choose appropriate paths.
USER_ID=99
GROUP_ID=100
TZ=Etc/UTC

# Browser and desktop
WEB_AUDIO=1
WEB_HOST_CLIPBOARD_SYNC=1
WEB_FILE_MANAGER=1
WEB_FILE_MANAGER_ALLOWED_PATHS=AUTO
DARK_MODE=0
KEEP_APP_RUNNING=1
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

# Optional HTTPS and authentication; disabled by default.
# Set credentials privately only when enabling authentication. Never commit secrets.
SECURE_CONNECTION=0
WEB_AUTHENTICATION=0
WEB_AUTHENTICATION_TOKEN_VALIDITY_TIME=24
WEB_AUTHENTICATION_USERNAME=
WEB_AUTHENTICATION_PASSWORD=
