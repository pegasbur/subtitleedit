#!/bin/bash
set -euo pipefail

tessdata_target="${TESSDATA_PREFIX:-/config/tessdata}"
mkdir -p "${tessdata_target}"

eng_model="$(find /usr/share/tesseract-ocr -type f -name eng.traineddata -print -quit 2>/dev/null || true)"
if [[ -n "${eng_model}" ]]; then
  tessdata_source="$(dirname "${eng_model}")"
  cp -an "${tessdata_source}/." "${tessdata_target}/"
fi
